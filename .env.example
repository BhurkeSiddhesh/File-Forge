# Forge Files Environment Variables

# The port the server listens on
PORT=8001

# Public URL used in canonical links, sitemap.xml, and robots.txt
BASE_URL=http://localhost:8001

# Maximum upload size in MB (per file)
MAX_UPLOAD_MB=50

# Total upload budget in MB for the multi-file endpoints (merge tools,
# images->PDF), across the whole request. Defaults to MAX_UPLOAD_MB.
# MAX_UPLOAD_TOTAL_MB=50

# Require the ff_sid session cookie to match when redeeming a download token.
# Off by default: the Capacitor mobile app calls this API cross-origin, where
# the browser does not attach the cookie. The token itself (192 bits) is the
# access control; this only hardens a leaked link.
DOWNLOAD_BIND_SESSION=0

# Rate limits (requests per minute per IP)
RATE_LIMIT_ENABLED=1
RATE_LIMIT_HEAVY=5
RATE_LIMIT_LIGHT=20
# Funnel beacons (/api/track) get their own generous bucket
RATE_LIMIT_TRACK=120
# Comma-separated headers to read the client address from, most-trusted first.
# Default: "cf-connecting-ip,x-real-ip". Cloudflare sets CF-Connecting-IP from
# the real connection and strips any client-supplied copy, so it cannot be
# forged; X-Forwarded-For deliberately is NOT trusted. Set to an empty value on
# a direct (unproxied) deploy to use the socket peer instead.
# RATE_LIMIT_TRUSTED_HEADER=cf-connecting-ip,x-real-ip

# Extra allowed CORS origins, comma-separated (e.g. the production web domain).
# capacitor://localhost and http://localhost are always allowed — the mobile
# app loads its assets from those.
# CORS_EXTRA_ORIGINS=https://www.forgefiles.org
# Allow credentialed cross-origin requests. Off by default: the API uses a
# bearer token, not the ff_sid cookie.
CORS_ALLOW_CREDENTIALS=0

# Stale uploads/outputs older than this are auto-purged (in seconds)
FILE_TTL_SECONDS=3600

# Set to 1 to disable AI Layout Recovery (for low-memory hosts)
DISABLE_AI=0

# Set to 1 to pre-load PaddleOCR models at startup
WARMUP_AI=0

# Set to "production" in production deployments to disable Swagger /docs
ENV=development

# Application log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Where the anonymous operation-event SQLite DB lives (default: data/events.db)
# EVENT_DB_PATH=data/events.db

# Google AdSense configuration (Optional)
# ADSENSE_CLIENT=ca-pub-1234567890123456
# ADSENSE_SLOT=1234567890
# ADSENSE_ADS_TXT=google.com, pub-1234567890123456, DIRECT, f08c47fec0942fa0

# Cloudflare Web Analytics (Optional). Paste the site token from the Cloudflare
# dashboard: Web Analytics -> your site -> "JS snippet" (the data-cf-beacon
# "token" value). When set, a cookieless beacon is injected on every page and
# records page views + Core Web Vitals. Leave unset to emit no analytics JS.
# CLOUDFLARE_ANALYTICS_TOKEN=
